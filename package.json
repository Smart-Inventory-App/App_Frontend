{
  "name": "app_frontend",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest --watchAll=false --passWithNoTests",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "build": "node -v && expo export --platform web",
    "serve": "serve dist --single",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo-google-fonts/figtree": "^0.4.1",
    "@expo-google-fonts/roboto": "^0.4.3",
    "@expo-google-fonts/roboto-flex": "^0.4.1",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-google-signin/google-signin": "^16.1.5",
    "@tanstack/react-query": "^4.18.0",
    "@trpc/client": "^10.45.0",
    "@trpc/react-query": "^10.45.0",
    "@trpc/server": "^10.45.0",
    "axios": "^1.6.5",
    "expo": "~55.0.31",
    "expo-auth-session": "~55.0.18",
    "expo-constants": "~55.0.17",
    "expo-font": "~55.0.8",
    "expo-image-picker": "~55.0.24",
    "expo-linking": "~55.0.17",
    "expo-localization": "~55.0.19",
    "expo-notifications": "~55.0.27",
    "expo-router": "~55.0.18",
    "expo-secure-store": "~55.0.18",
    "expo-status-bar": "~55.0.6",
    "expo-web-browser": "~55.0.20",
    "firebase": "^12.14.0",
    "i18next": "^26.3.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-i18next": "^17.0.8",
    "react-native": "0.83.10",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.23.0",
    "react-native-web": "^0.21.0",
    "serve": "^14.2.6",
    "wrangler": "^4.97.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@testing-library/react-native": "^12.4.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "@types/react": "~19.2.10",
    "babel-preset-expo": "~55.0.8",
    "eslint": "^8.57.0",
    "eslint-config-expo": "~55.0.1",
    "jest": "^29.7.0",
    "jest-expo": "~55.0.22",
    "react-test-renderer": "19.1.0",
    "typescript": "~5.9.2"
  },
  "id": "engines",
  "engines": {
    "node": ">=22"
  },
  "jest": {
    "preset": "jest-expo",
    "testTimeout": 30000,
    "setupFiles": [
      "./jest.setup.js"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg|firebase|@firebase|expo-notifications)"
    ]
  },
  "private": true
}
